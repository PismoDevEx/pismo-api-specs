{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Deposit product balance confirmation",
  "description": "Deposit product balance submission confirmed.",
  "required": [
    "balance_id",
    "account_id",
    "program_id",
    "product_id",
    "balance",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "balance_id": {
      "type": "string",
      "format": "uuid",
      "title": "Balance ID",
      "description": "Unique identifier for the balance submission, corresponding to the balance history event ID.",
      "examples": [
        "bd0ae73e-ded2-4b73-a52d-0a35e9a760b0"
      ]
    },
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Account ID. Accepts either a Pismo account ID or an external account ID from the client.",
      "examples": [
        123
      ]
    },
    "program_id": {
      "type": "integer",
      "title": "Program ID",
      "description": "Program ID of the account performing the operation.",
      "examples": [
        123
      ]
    },
    "product_id": {
      "type": "string",
      "format": "uuid",
      "title": "Product ID",
      "description": "Pismo product ID.",
      "examples": [
        "4aa5556f-8062-4705-9aca-7246c4d1f36d"
      ]
    },
    "interest_plan_id": {
      "type": "string",
      "format": "uuid",
      "title": "Interest Plan ID",
      "description": "ID generated by the interest management flow",
      "examples": [
        "97f45710-4334-4639-aebf-1b929959f4c0"
      ]
    },
    "balance": {
      "type": "number",
      "format": "double",
      "title": "Balance",
      "description": "The submitted balance amount used as the basis for interest calculation.",
      "examples": [
        23.95
      ]
    },
    "value_date": {
      "type": "string",
      "format": "date",
      "title": "Value Date",
      "description": "The reference date of the balance submission.",
      "examples": [
        "2024-10-15"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Status of the balance confirmation.",
      "enum": [
        "CONFIRMED",
        "CONFIRMATION_ERROR"
      ]
    },
    "error_message": {
      "type": "string",
      "title": "Error message",
      "description": "Detailed error message if the balance confirmation fails.",
      "examples": [
        "Error message"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Creation date time",
      "description": "Balance submission creation date time.",
      "examples": [
        "2024-10-15T13:26:25Z"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Update date time",
      "description": "Balance submission update date time.",
      "examples": [
        "2024-10-15T13:30:25Z"
      ]
    }
  }
}