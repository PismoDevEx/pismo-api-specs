{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Loan product created",
  "description": "This event occurs when creating a loan product. Generated by <a href='https://developers.pismo.io/pismo-docs/reference/createloanproductv2' target='_blank'>Create loan product</a>. Refer to the <a href='https://developers.pismo.io/pismo-docs/docs/create-a-loan' target='_blank'>Create a loan</a> guide for details.",
  "required": [
    "collateral",
    "disbursement_method",
    "product_id",
    "product_type",
    "product_name",
    "currency",
    "processing_codes"
  ],
  "properties": {
    "org_id": {
      "$id": "#/properties/org_id",
      "type": "string",
      "title": "Org ID",
      "description": "Organization/tenant ID for organization associated with loan product",
      "examples": [
        "TN-89e56522-726a-453e-ba6d-796b03245128"
      ]
    },
    "product_id": {
      "$id": "#/properties/product_id",
      "type": "string",
      "title": "Loan product ID",
      "description": "Loan product ID",
      "examples": [
        "89e56522-726a-453e-ba6d-796b03245128",
        "BNPL_PRODUCT_2022"
      ]
    },
    "product_name": {
      "$id": "#/properties/product_name",
      "type": "string",
      "title": "Loan product name",
      "description": "Loan product name",
      "examples": [
        "Personal loan 2022"
      ]
    },
    "product_type": {
      "$id": "#/properties/product_type",
      "type": "string",
      "title": "Loan product type",
      "description": "Loan product type",
      "enum": [
        "PERSONAL",
        "BNPL"
      ],
      "examples": [
        "BNPL"
      ]
    },
    "version": {
      "$id": "#/properties/version",
      "type": "string",
      "title": "Version",
      "description": "Loan product version",
      "examples": [
        "1",
        "2",
        "3"
      ]
    },
    "created_at": {
      "$id": "#/properties/created_at",
      "type": "string",
      "format": "date-time",
      "title": "Created at",
      "description": "ISO 8601 / RFC 3339 format: YYYY-MM-DDThh:mm:ss.sssZ (UTC)",
      "examples": [
        "2023-03-10T14:48:00.000Z"
      ]
    },
    "status": {
      "$id": "#/properties/status",
      "type": "string",
      "title": "Status",
      "description": "Loan product status",
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ],
      "examples": [
        "ACTIVE"
      ]
    },
    "collateral": {
      "$id": "#/properties/collateral",
      "type": "string",
      "title": "Collateral",
      "description": "Loan product collateral type",
      "enum": [
        "NONE",
        "SINGLE",
        "COLLATERAL_MULTIPLE"
      ],
      "examples": [
        "NONE"
      ]
    },
    "loan_activation_method": {
      "$id": "#/properties/loan_activation_method",
      "type": "string",
      "title": "Loan activation method",
      "description": "Loan product loan activation method",
      "enum": [
        "ON_BOOKING",
        "ON_DISBURSEMENT",
        "ON_DISBURSEMENT_OR_REPAYMENT",
        "ON_REPAYMENT"
      ],
      "examples": [
        "ON_BOOKING"
      ]
    },
    "repayment_hierarchy_code": {
      "$id": "#/properties/repayment_hierarchy_code",
      "type": "string",
      "title": "Repayment hierarchy code",
      "description": "Loan repayment hierarchy code",
      "examples": [
        "RH-2022-0001"
      ]
    },
    "repayment_calculation_method": {
      "$id": "#/properties/repayment_calculation_method",
      "type": "string",
      "title": "Repayment calculation method",
      "description": "Loan repayment calculation method",
      "enum": [
        "RATES"
      ],
      "examples": [
        "RATES"
      ]
    },
    "disbursement_method": {
      "$id": "#/properties/disbursement_method",
      "type": "object",
      "title": "Disbursement Method rules",
      "description": "Loan product disbursement method rules",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$id": "#/properties/disbursement_method/type",
          "type": "string",
          "title": "Disbursement Method type",
          "description": "Loan product disbursement method type",
          "enum": [
            "NONE",
            "SINGLE",
            "MULTIPLE"
          ],
          "examples": [
            "SINGLE"
          ]
        }
      }
    },
    "idempotency_key": {
      "$id": "#/properties/idempotency_key",
      "title": "Idempotency key",
      "description": "Key that ensures idempotency of the operation",
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "48704d83-0412-431f-816a-50ba81451148"
      ]
    },
    "currency": {
      "$id": "#/properties/currency",
      "type": "string",
      "title": "Currency",
      "description": "Currency code for the loan product in ISO 4217 format",
      "examples": [
        "USD",
        "BRL"
      ]
    },
    "processing_codes": {
      "type": "object",
      "$id": "#/properties/processing_codes",
      "title": "Processing Codes",
      "description": "Processing codes used for this loan product",
      "required": [
        "booking",
        "repayment"
      ],
      "properties": {
        "booking": {
          "$id": "#/properties/processing_codes/booking",
          "type": "array",
          "title": "Booking processing codes",
          "description": "Processing codes for loan booking",
          "items": {
            "$ref": "#/definitions/processing_code"
          }
        },
        "repayment": {
          "$id": "#/properties/processing_codes/repayment",
          "type": "array",
          "title": "Repayment processing codes",
          "description": "Processing codes for loan repayment",
          "items": {
            "$ref": "#/definitions/processing_code"
          }
        },
        "present_value_discount": {
          "$id": "#/properties/processing_codes/present_value_discount",
          "type": "array",
          "title": "Present value discount processing codes",
          "description": "Processing codes for loan present value discount",
          "items": {
            "$ref": "#/definitions/processing_code"
          }
        },
        "penalty_accruals": {
          "$id": "#/properties/processing_codes/penalty_accruals",
          "type": "array",
          "title": "Penalty accruals processing codes",
          "description": "Processing codes for loan penalty accruals",
          "items": {
            "$ref": "#/definitions/processing_code"
          }
        },
        "penalty_waiver": {
          "$id": "#/properties/processing_codes/penalty_waiver",
          "type": "array",
          "title": "Penalty waiver processing codes",
          "description": "Processing codes for loan penalty waiver",
          "items": {
            "$ref": "#/definitions/processing_code"
          }
        },
        "restructuring": {
          "$id": "#/properties/processing_codes/restructuring",
          "type": "array",
          "title": "Restructuring processing codes",
          "description": "Processing codes for loan restructuring",
          "items": {
            "$ref": "#/definitions/processing_code"
          }
        },
        "insurance": {
          "$id": "#/properties/processing_codes/insurance",
          "type": "object",
          "title": "Insurance processing codes",
          "description": "Processing codes for loan insurance",
          "properties": {
            "booking": {
              "$id": "#/properties/processing_codes/insurance/booking",
              "type": "array",
              "title": "Insurance booking processing codes",
              "description": "Processing codes for loan insurance booking",
              "items": {
                "$ref": "#/definitions/processing_code"
              }
            },
            "repayment": {
              "$id": "#/properties/processing_codes/insurance/repayment",
              "type": "array",
              "title": "Insurance repayment processing codes",
              "description": "Processing codes for insurance on loan repayment",
              "items": {
                "$ref": "#/definitions/processing_code"
              }
            }
          }
        },
        "disbursement": {
          "$id": "#/properties/processing_codes/disbursement",
          "type": "object",
          "title": "Disbursement processing code",
          "description": "Processing code for loan disbursement",
          "properties": {
            "internal": {
              "$id": "#/properties/processing_codes/disbursement/internal",
              "type": "array",
              "title": "Internal disbursement processing codes",
              "description": "Processing codes for internal loan disbursement",
              "items": {
                "$ref": "#/definitions/processing_code"
              }
            },
            "external": {
              "$id": "#/properties/processing_codes/disbursement/external",
              "type": "array",
              "title": "External disbursement processing codes",
              "description": "Processing codes for external loan disbursement",
              "items": {
                "$ref": "#/definitions/processing_code"
              }
            }
          }
        },
        "prepayment": {
          "$id": "#/properties/processing_codes/prepayment",
          "type": "object",
          "title": "Prepayment processing codes",
          "description": "Processing codes for loan prepayment",
          "properties": {
            "fee": {
              "$id": "#/properties/processing_codes/prepayment/fee",
              "type": "array",
              "title": "Prepayment fee processing codes",
              "description": "Processing codes for loan prepayment fee",
              "items": {
                "$ref": "#/definitions/processing_code"
              }
            }
          }
        },
        "early_final_settlement": {
          "$id": "#/properties/processing_codes/early_final_settlement",
          "type": "object",
          "title": "Early final settlement processing codes",
          "description": "Processing codes for loan early final settlement (EFS)",
          "properties": {
            "fee": {
              "$id": "#/properties/processing_codes/early_final_settlement/fee",
              "type": "array",
              "title": "Early final settlement fee processing codes",
              "description": "Processing codes for loan early final settlement fee",
              "items": {
                "$ref": "#/definitions/processing_code"
              }
            }
          }
        }
      }
    },
    "interest_plan_ids": {
      "$id": "#/properties/interest_plan_ids",
      "title": "List of interest plan IDs",
      "type": "array",
      "items": {
        "$id": "#/properties/interest_plan_ids/items",
        "type": "string",
        "title": "Interest plan ID list item",
        "examples": [
          "b935acaf-886c-4817-8f7c-c2cc3ce4d509"
        ]
      }
    },
    "early_final_settlement": {
      "$id": "#/properties/early_final_settlement",
      "type": "object",
      "title": "Early final settlement",
      "description": "Loan product early final settlement (EFS) rules",
      "properties": {
        "penalty": {
          "$ref": "#/definitions/penalty"
        },
        "lock_in_period": {
          "$ref": "#/definitions/lock_in_period"
        }
      }
    },
    "prepayment": {
      "$id": "#/properties/prepayment",
      "type": "object",
      "title": "Prepayment",
      "description": "Loan product prepayment rules",
      "properties": {
        "penalty": {
          "$ref": "#/definitions/penalty"
        },
        "lock_in_period": {
          "$ref": "#/definitions/lock_in_period"
        },
        "reduce_option": {
          "$id": "#/properties/prepayment/reduce_option",
          "type": "array",
          "title": "Reduce options",
          "description": "Options for reducing the loan when prepaying",
          "items": {
            "$id": "#/properties/prepayment/reduce_option/items",
            "type": "string",
            "title": "Reduce option",
            "description": "Prepayment reduce option",
            "enum": [
              "TERM",
              "INSTALLMENT"
            ],
            "examples": [
              "TERM"
            ]
          }
        }
      }
    },
    "minimum_total_payment": {
      "$id": "#/properties/minimum_total_payment",
      "type": "number",
      "title": "Minimum total payment",
      "description": "Minimum total payment amount for the loan product",
      "examples": [
        100.0
      ]
    },
    "grace_period_days": {
      "$id": "#/properties/grace_period_days",
      "type": "integer",
      "title": "Grace period days",
      "description": "Number of grace period days",
      "examples": [
        10
      ]
    },
    "updated_at": {
      "$id": "#/properties/updated_at",
      "type": "string",
      "format": "date-time",
      "title": "Updated at",
      "description": "ISO 8601 / RFC 3339 format: YYYY-MM-DDThh:mm:ss.sssZ (UTC)",
      "examples": [
        "2023-03-10T14:48:00.000Z"
      ]
    },
    "parameters": {
      "$id": "#/properties/parameters",
      "type": "object",
      "title": "Parameters",
      "description": "Additional loan product parameters",
      "properties": {
        "stop_accrual_number_of_days": {
          "$id": "#/properties/parameters/stop_accrual_number_of_days",
          "type": "integer",
          "title": "Stop accrual number of days",
          "description": "Number of days after which interest accrual stops",
          "examples": [
            90
          ]
        },
        "overdue_threshold_days": {
          "$id": "#/properties/parameters/overdue_threshold_days",
          "type": "integer",
          "title": "Overdue threshold days",
          "description": "Number of days after which the loan is considered overdue",
          "examples": [
            5
          ]
        }
      }
    }
  },
  "definitions": {
    "processing_code": {
      "$id": "#/definitions/processing_code",
      "type": "string",
      "title": "Processing code",
      "description": "Processing code",
      "examples": [
        "202526"
      ]
    },
    "lock_in_period": {
      "$id": "#/definitions/lock_in_period",
      "type": "integer",
      "title": "Lock-in period",
      "description": "Number of installments during which the operation is not allowed",
      "examples": [
        3
      ]
    },
    "penalty": {
      "$id": "#/definitions/penalty",
      "type": "object",
      "title": "Penalty",
      "description": "Penalty configuration",
      "properties": {
        "type": {
          "$id": "#/definitions/penalty/type",
          "type": "string",
          "title": "Penalty type",
          "description": "Penalty type",
          "enum": [
            "PERCENTAGE",
            "FIXED_AMOUNT"
          ],
          "examples": [
            "PERCENTAGE"
          ]
        },
        "value": {
          "$id": "#/definitions/penalty/value",
          "type": "number",
          "title": "Penalty value",
          "description": "Penalty value, interpreted as a percentage (0 to 1) or a fixed amount depending on the penalty type",
          "examples": [
            0.05
          ]
        }
      }
    }
  }
}