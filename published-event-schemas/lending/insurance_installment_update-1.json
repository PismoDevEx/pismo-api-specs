{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Insurance installment updated",
  "description": "This event occurs when an insurance installment is updated.",
  "required": [
    "installment_id",
    "org_id",
    "loan_id",
    "insurance_id",
    "currency",
    "account_id",
    "current_status",
    "principal_amount",
    "amount",
    "due_date",
    "updated_at"
  ],
  "properties": {
    "installment_id": {
      "$id": "#/properties/installment_id",
      "type": "string",
      "title": "Installment ID",
      "description": "Installment ID",
      "example": "7da3db3b-400d-4851-a362-2022dab27284"
    },
    "org_id": {
      "$id": "#/properties/org_id",
      "type": "string",
      "title": "Org ID",
      "description": "Organization/tenant ID",
      "example": "TN-89e56522-726a-453e-ba6d-796b03245128"
    },
    "loan_id": {
      "$id": "#/properties/loan_id",
      "type": "string",
      "title": "Loan ID",
      "description": "Loan ID",
      "example": "ded913af-abc9-4769-b179-068ed6181ec5"
    },
    "insurance_id": {
      "$id": "#/properties/insurance_id",
      "type": "string",
      "title": "Insurance ID",
      "description": "Insurance ID",
      "example": "e8b7c9a2-4f1d-4c3b-9e2a-7f6d5b4a3c2e"
    },
    "repayment_id": {
      "$id": "#/properties/repayment_id",
      "type": "string",
      "title": "Repayment ID",
      "description": "Repayment ID",
      "example": "c2f4a1e7-9b3d-4e2a-8c1f-7d2e4b6a5f3c"
    },
    "installment": {
      "$id": "#/properties/installment",
      "type": "number",
      "title": "Installment index",
      "description": "Index value for the insurance installment. For example, with a three-part installment plan, the index value would at 1 and increment sequentially 1, 2, 3.",
      "example": 12
    },
    "currency": {
      "$id": "#/properties/currency",
      "type": "string",
      "title": "Currency",
      "description": "ISO 4217 3-letter currency code for repayment",
      "maxLength": 3,
      "examples": [
        "BRL",
        "USD"
      ]
    },
    "account_id": {
      "$id": "#/properties/account_id",
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo platform account ID",
      "example": 12176
    },
    "principal_amount": {
      "$id": "#/properties/principal_amount",
      "type": "number",
      "title": "Principal amount authorized",
      "description": "Principal amount authorized without charges or taxes.",
      "example": 336.66
    },
    "interest_amount": {
      "$id": "#/properties/interest_amount",
      "type": [
        "number",
        "null"
      ],
      "title": "Interest amount",
      "description": "Installment interest amount",
      "example": 336.66
    },
    "penalty_amount": {
      "$id": "#/properties/penalty_amount",
      "type": "number",
      "title": "Penalty amount",
      "description": "Installment penalty amount",
      "example": 336.66
    },
    "fee_amount": {
      "$id": "#/properties/fee_amount",
      "type": "number",
      "title": "Fee amount",
      "description": "Installment fee amount",
      "example": 336.66
    },
    "charge_amount": {
      "$id": "#/properties/charge_amount",
      "type": "number",
      "title": "Charge amount",
      "description": "Installment charge amount",
      "example": 336.66
    },
    "tax_amount": {
      "$id": "#/properties/tax_amount",
      "type": "number",
      "title": "Tax amount",
      "description": "Installment tax amount",
      "example": 36.66
    },
    "amount": {
      "$id": "#/properties/amount",
      "type": "number",
      "title": "Amount",
      "description": "Installment paid amount",
      "example": 1336.66
    },
    "due_date": {
      "$id": "#/properties/due_date",
      "type": "string",
      "title": "Due date",
      "description": "ISO 8601 date format: YYYY-MM-DD",
      "format": "date",
      "example": "2023-07-01"
    },
    "real_due_date": {
      "$id": "#/properties/real_due_date",
      "type": "string",
      "title": "Real due date",
      "description": "ISO 8601 date format: YYYY-MM-DD",
      "format": "date",
      "example": "2023-07-01"
    },
    "created_at": {
      "$id": "#/properties/created_at",
      "type": "string",
      "title": "Created date",
      "description": "ISO 8601 / RFC 3339 format: YYYY-MM-DDThh:mm:ss.sssZ (UTC)",
      "format": "date-time",
      "example": "2020-12-29T19:48:25.000Z"
    },
    "updated_at": {
      "$id": "#/properties/updated_at",
      "type": "string",
      "title": "Updated date",
      "description": "ISO 8601 / RFC 3339 format: YYYY-MM-DDThh:mm:ss.sssZ (UTC)",
      "format": "date-time",
      "example": "2020-12-29T19:48:25.000Z"
    },
    "current_status": {
      "$id": "#/properties/current_status",
      "type": "string",
      "title": "Current status",
      "description": "Installment current status",
      "enum": [
        "PENDING",
        "PROCESSING",
        "DONE",
        "SCHEDULED",
        "PAST_DUE",
        "PAID",
        "PARTIALLY_PAID",
        "CANCELED",
        "PENDING_PAYMENT",
        "PAST_DUE_PENDING_PAYMENT",
        "ACTIVE",
        "OVERDUE",
        "OVERDUE_PENDING_PAYMENT",
        "IN_GRACE_PERIOD",
        "IN_GRACE_PERIOD_PENDING_PAYMENT",
        "PARTIALLY_PAID_IN_GRACE_PERIOD",
        "PAID_WITHIN_GRACE",
        "PARTIALLY_PAID_PENDING_PAYMENT",
        "PAST_DUE_PARTIALLY_PAID",
        "OVERDUE_PARTIALLY_PAID"
      ],
      "example": "PAST_DUE"
    },
    "previous_status": {
      "$id": "#/properties/previous_status",
      "type": "string",
      "title": "Previous status",
      "description": "Installment previous status",
      "enum": [
        "PENDING",
        "PROCESSING",
        "DONE",
        "SCHEDULED",
        "PAST_DUE",
        "PAID",
        "PARTIALLY_PAID",
        "CANCELED",
        "PENDING_PAYMENT",
        "PAST_DUE_PENDING_PAYMENT",
        "ACTIVE",
        "OVERDUE",
        "OVERDUE_PENDING_PAYMENT",
        "IN_GRACE_PERIOD",
        "IN_GRACE_PERIOD_PENDING_PAYMENT",
        "PARTIALLY_PAID_IN_GRACE_PERIOD",
        "PAID_WITHIN_GRACE",
        "PARTIALLY_PAID_PENDING_PAYMENT",
        "PAST_DUE_PARTIALLY_PAID",
        "OVERDUE_PARTIALLY_PAID"
      ],
      "example": "DONE"
    },
    "transactions_ids": {
      "$id": "#/properties/transactions_ids",
      "title": "Installment transactions IDs",
      "type": "array",
      "description": "Transactions IDs associated with an insurance installment",
      "items": {
        "type": "number",
        "examples": [
          "42069",
          "2123"
        ]
      }
    }
  }
}