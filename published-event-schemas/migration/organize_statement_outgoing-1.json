{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://pismo.io/events/migration/organize_statement_outgoing-1.json",
  "title": "Statement organized migration completed",
  "description": "Event generated when a statement organized migration finishes and the result is reported. Result can be either `SUCCESS` or `FAIL`.",
  "type": "object",
  "required": [
    "operation",
    "status",
    "message",
    "migration",
    "entity"
  ],
  "properties": {
    "operation": {
      "$id": "#/properties/operation",
      "type": "string",
      "title": "Statement organized operation",
      "enum": [
        "ORGANIZE"
      ],
      "examples": [
        "ORGANIZE"
      ]
    },
    "status": {
      "$id": "#/properties/status",
      "type": "string",
      "title": "Migration status",
      "description": "If the result of the statement organized migration was a success or not",
      "enum": [
        "SUCCESS",
        "FAIL"
      ],
      "examples": [
        "SUCCESS",
        "FAIL"
      ]
    },
    "code": {
      "$id": "#/properties/code",
      "type": "string",
      "title": "Migration message code",
      "description": "The code of message for systems",
      "examples": [
        "MIGR-0001"
      ]
    },
    "message": {
      "$id": "#/properties/message",
      "type": "string",
      "title": "The message schema",
      "description": "Message of statement organized migration result",
      "default": "",
      "examples": [
        "Statement organized with success"
      ]
    },
    "migration": {
      "$id": "#/properties/migration",
      "type": "object",
      "title": "Statement organized migration identifiers object",
      "default": {},
      "examples": [
        {
          "id": "235771468",
          "version_date": "2024-12-18T21:22:35.256106Z"
        }
      ],
      "required": [
        "id",
        "version_date"
      ],
      "properties": {
        "id": {
          "$id": "#/properties/migration/properties/id",
          "type": "string",
          "title": "Migration Identifier",
          "description": "Statement organized migration uses the Pismo's account_id as migration_id",
          "examples": [
            "235771468"
          ]
        },
        "version_date": {
          "$id": "#/properties/migration/properties/version_date",
          "type": "string",
          "format": "date-time",
          "title": "Date and time of statement organized migration",
          "examples": [
            "2024-12-18T21:22:35.256106Z"
          ]
        }
      },
      "additionalProperties": true
    },
    "entity": {
      "$id": "#/properties/entity",
      "type": "object",
      "title": "Statement organized entity",
      "default": {},
      "required": [
        "account_id",
        "statements"
      ],
      "properties": {
        "account_id": {
          "$id": "#/properties/entity/properties/account_id",
          "type": "integer",
          "description": "Account identifier generated by Pismo",
          "examples": [
            235771468
          ]
        },
        "program_id": {
          "$id": "#/properties/entity/properties/program_id",
          "type": "integer",
          "description": "Program identifier of the account",
          "examples": [
            123
          ]
        },
        "program_type_id": {
          "$id": "#/properties/entity/properties/program_type_id",
          "type": "integer",
          "description": "Program type identifier of the account",
          "examples": [
            45
          ]
        },
        "customer_id": {
          "$id": "#/properties/entity/properties/customer_id",
          "type": "integer",
          "description": "Customer identifier of the account",
          "examples": [
            10000020
          ]
        },
        "current_cycle": {
          "$id": "#/properties/entity/properties/current_cycle",
          "type": "integer",
          "title": "Current cycle of the account after organize",
          "examples": [
            3
          ]
        },
        "previous_statement_is_due": {
          "$id": "#/properties/entity/properties/previous_statement_is_due",
          "type": "boolean",
          "title": "Indicates if the previous statement is due",
          "examples": [
            false
          ]
        },
        "previous_statement_id": {
          "$id": "#/properties/entity/properties/previous_statement_id",
          "type": "integer",
          "title": "Previous statement identifier",
          "examples": [
            1952499422
          ]
        },
        "statements": {
          "$id": "#/properties/entity/properties/statements",
          "type": "array",
          "description": "Statements organized for the account",
          "items": {
            "type": "object",
            "description": "Organized statement entry",
            "required": [
              "statement_id",
              "cycle"
            ],
            "properties": {
              "statement_id": {
                "$id": "#/properties/entity/properties/statements/items/properties/statement_id",
                "type": "integer",
                "title": "Pismo's statement id",
                "examples": [
                  1952499422
                ]
              },
              "cycle": {
                "$id": "#/properties/entity/properties/statements/items/properties/cycle",
                "type": "integer",
                "title": "Cycle of the organized statement",
                "examples": [
                  2
                ]
              }
            },
            "additionalProperties": true
          },
          "examples": [
            [
              {
                "statement_id": 1952499422,
                "cycle": 2
              },
              {
                "statement_id": 1952499937,
                "cycle": 3
              }
            ]
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "operation": "ORGANIZE",
      "status": "SUCCESS",
      "code": "MIGR-0001",
      "message": "Statement organized with success",
      "migration": {
        "id": "235771468",
        "version_date": "2024-12-18T21:22:35.256106Z"
      },
      "entity": {
        "account_id": 235771468,
        "program_id": 123,
        "program_type_id": 45,
        "customer_id": 10000020,
        "current_cycle": 3,
        "previous_statement_is_due": false,
        "previous_statement_id": 1952499422,
        "statements": [
          {
            "statement_id": 1952499422,
            "cycle": 2
          },
          {
            "statement_id": 1952499937,
            "cycle": 3
          }
        ]
      }
    },
    {
      "operation": "ORGANIZE",
      "status": "FAIL",
      "code": "MIGR-9999",
      "message": "Statement organization failed",
      "migration": {
        "id": "235771468",
        "version_date": "2024-12-18T21:22:35.256106Z"
      },
      "entity": {
        "account_id": 235771468,
        "program_id": 123,
        "program_type_id": 45,
        "customer_id": 10000020,
        "current_cycle": 3,
        "previous_statement_is_due": false,
        "previous_statement_id": 1952499422,
        "statements": []
      }
    }
  ]
}