{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://pismo.io/events/migration/account_rollback_outgoing-1.json",
  "type": "object",
  "title": "Account migration rollback completed",
  "description": "Event that may be generated when the rollback for an account under migration is completed. Rollback is an internal process that allows migrated data associated with an account *still under migration* to be undone so that they can be migrated over from scratch. Both the process and the event are available under per-org configuration so contact your Pismo representative to inquire about usage.",
  "examples": [
    {
      "operation": "ROLLBACK",
      "status": "SUCCESS",
      "migration": {
        "id": "account-migration-id",
        "phase_id": "account-phase-id"
      },
      "entity": {
        "account_id": 1,
        "rollback_steps": [
          {
            "step": "ACCOUNT_STATUS",
            "status": "SUCCESS"
          },
          {
            "step": "AUTHORIZATION",
            "status": "SUCCESS"
          },
          {
            "step": "TRANSACTION",
            "status": "SUCCESS"
          }
        ]
      }
    },
    {
      "operation": "ROLLBACK",
      "status": "FAIL",
      "migration": {
        "id": "account-migration-id",
        "phase_id": "account-phase-id"
      },
      "entity": {
        "account_id": 1,
        "rollback_steps": [
          {
            "step": "ACCOUNT_STATUS",
            "status": "SUCCESS"
          },
          {
            "step": "AUTHORIZATION",
            "status": "TIMEOUT"
          },
          {
            "step": "TRANSACTION",
            "status": "FAIL"
          }
        ]
      }
    }
  ],
  "required": [
    "operation",
    "status",
    "migration",
    "entity"
  ],
  "properties": {
    "operation": {
      "$id": "#/properties/operation",
      "type": "string",
      "title": "Operation",
      "description": "What operation this event is the result of",
      "enum": [
        "ROLLBACK"
      ],
      "examples": [
        "ROLLBACK"
      ]
    },
    "status": {
      "$id": "#/properties/status",
      "type": "string",
      "title": "Overall process status",
      "description": "Whether the overall rollback process was finished successfully or not.",
      "enum": [
        "SUCCESS",
        "FAIL"
      ],
      "examples": [
        "SUCCESS",
        "FAIL"
      ]
    },
    "migration": {
      "$id": "#/properties/migration",
      "type": "object",
      "title": "Migration Identifiers",
      "description": "Identifiers sent on start of migration process",
      "default": {},
      "examples": [
        {
          "id": "migration-id",
          "phase_id": "Rollout_Jan2022"
        }
      ],
      "required": [
        "id",
        "phase_id"
      ],
      "properties": {
        "id": {
          "$id": "#/properties/migration/properties/id",
          "type": "string",
          "title": "Migration Identifier for the account undergoing rollback",
          "examples": [
            "migration-id"
          ]
        },
        "phase_id": {
          "$id": "#/properties/migration/properties/phase_id",
          "type": "string",
          "title": "Phase ID (identifier for a group of migrating accounts) the account being rolled back is a part of",
          "examples": [
            "Rollout_Jan2022"
          ]
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "$id": "#/properties/entity",
      "type": "object",
      "title": "Pismo generated information",
      "examples": [
        {
          "account_id": 9999,
          "rollback_steps": [
            {
              "step": "ACCOUNT_STATUS",
              "status": "SUCCESS"
            },
            {
              "step": "AUTHORIZATION",
              "status": "SUCCESS"
            },
            {
              "step": "TRANSACTION",
              "status": "SUCCESS"
            }
          ]
        }
      ],
      "properties": {
        "account_id": {
          "$id": "#/properties/entity/properties/account_id",
          "type": "integer",
          "title": "Account Identifier",
          "description": "Account identifier generated by pismo.",
          "examples": [
            9999
          ]
        },
        "rollback_steps": {
          "$id": "#/properties/entity/properties/rollback_steps",
          "type": "array",
          "title": "Rollback step results",
          "description": "A Rollback is composed of multiple steps that each undo migration of a specific kind. Each item in this array represents the final status for that particular step.",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "$id": "#/properties/entity/properties/rollback_steps/items/properties/step",
                "type": "string",
                "title": "Rollback step name"
              },
              "status": {
                "$id": "#/properties/entity/properties/rollback_steps/items/properties/status",
                "type": "string",
                "title": "Rollback step status",
                "description": "Completion status of the specific rollback step",
                "enum": [
                  "SUCCESS",
                  "FAILURE",
                  "TIMEOUT"
                ],
                "examples": [
                  "SUCCESS",
                  "FAILURE",
                  "TIMEOUT"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}