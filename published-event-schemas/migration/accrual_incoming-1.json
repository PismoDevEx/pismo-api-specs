                    "description": "This field identifies the type of value.",
                    "enum": [
                      "REFINANCING",
                      "IOF",
                      "OVERDUE",
                      "FINE"
                    ],
                    "examples": [
                      "IOF",
                      "OVERDUE"
                    ]
                  },
                  "amount": {
                    "$id": "#/properties/entity/properties/accruals/items/anyOf/0/properties/amount",
                    "type": [
                      "string",
                      "integer",
                      "null"
                    ],
                    "description": "This field identifies the amount of value.",
                    "examples": [
                      0.423187
                    ]
                  },
                  "interest_rate": {
                    "$id": "#/properties/entity/properties/accruals/items/anyOf/0/properties/interest_rate",
                    "type": "number",
                    "description": "This field identifies the interest rate of value.",
                    "examples": [
                      0.0
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "projected_values": {
          "$id": "#/properties/entity/properties/projected_values",
          "type": "array",
          "description": "This field contains the projected values of accrual.",
          "examples": [
            [
              {
                "type": "IOF",
                "amount": 0.423187,
                "interest_rate": 0.0
              },
              {
                "type": "REFINANCING",
                "amount": 14.7,
                "interest_rate": 0.0
              }
            ]
          ],
          "additionalItems": true,
          "items": {
            "$id": "#/properties/entity/properties/projected_values/items",
            "anyOf": [
              {
                "$id": "#/properties/entity/properties/projected_values/items/anyOf/0",
                "type": "object",
                "examples": [
                  {
                    "type": "IOF",
                    "amount": 0.423187,
                    "interest_rate": 0.0
                  }
                ],
                "required": [
                  "type",
                  "amount"
                ],
                "properties": {
                  "type": {
                    "$id": "#/properties/entity/properties/projected_values/items/anyOf/0/properties/type",
                    "type": "string",
                    "description": "This field identifies the type of projected value.",
                    "enum": [
                      "REFINANCING",
                      "IOF",
                      "OVERDUE",
                      "FINE"
                    ],
                    "examples": [
                      "IOF",
                      "OVERDUE"
                    ]
                  },
                  "amount": {
                    "$id": "#/properties/entity/properties/projected_values/items/anyOf/0/properties/amount",
                    "type": [
                      "number",
                      "null",
                      "string"
                    ],
                    "description": "This field identifies the amount of projected value.",
                    "examples": [
                      0.423187
                    ]
                  },
                  "interest_rate": {
                    "$id": "#/properties/entity/properties/projected_values/items/anyOf/0/properties/interest_rate",
                    "type": "number",
                    "description": "This field identifies the projected interest rate of value.",
                    "examples": [
                      0.0
                    ]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "metadata": {
          "$id": "#/properties/entity/properties/metadata",
          "type": "object",
          "description": "This field contains others accrual information.",
          "default": {},
          "examples": [
            {
              "balanceIof": "0000000000000",
              "customerAccountId": "0004002479013933093",
              "customerOrgId": "004",
              "planCode": "00000",
              "planSequence": "000",
              "reference": "00000000000000000000000"
            }
          ],
          "additionalProperties": true
