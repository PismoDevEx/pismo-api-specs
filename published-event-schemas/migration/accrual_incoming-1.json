            "amount": 0,
            "interestRate": 0.0
          }
        ],
        "metadata": {
          "balanceIof": "0000000000000",
          "customerAccountId": "0004002479013933093",
          "customerOrgId": "004",
          "planCode": "00000",
          "planSequence": "000",
          "reference": "00000000000000000000000"
        }
      }
    }
