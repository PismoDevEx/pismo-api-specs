{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "Installment advancement not processed",
  "description": "Event generated when an installment advancement v2 is not processed due to a business validation",
  "required": [
    "installment_advancement_id",
    "org_id",
    "program_id",
    "account_id",
    "error_message"
  ],
  "properties": {
    "installment_advancement_id": {
      "type": "integer",
      "description": "Installment advancement ID",
      "examples": [
        1010
      ]
    },
    "org_id": {
      "type": "string",
      "description": "Organization ID",
      "examples": [
        "TN-cc8f8b89-233a-4582-9f36-63ee85278d6d"
      ]
    },
    "program_id": {
      "type": "integer",
      "description": "Program ID",
      "examples": [
        1122
      ]
    },
    "account_id": {
      "type": "integer",
      "description": "Account ID",
      "examples": [
        9832195123
      ]
    },
    "error_message": {
      "type": "string",
      "description": "Error message explaining why the installment advancement can't be processed",
      "examples": [
        "No installments to advance were found."
      ]
    }
  }
}