{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Calendar updated",
  "description": "This event is generated when a calendar is updated.",
  "required": [
    "calendar_id",
    "program_due_date_id",
    "cycle_closing_date",
    "due_date",
    "best_transaction_day"
  ],
  "properties": {
    "calendar_id": {
      "type": "integer",
      "description": "Updated calendar ID",
      "examples": [
        919265
      ]
    },
    "program_due_date_id": {
      "type": "integer",
      "description": "Program due date ID",
      "examples": [
        3840
      ]
    },
    "cycle_closing_date": {
      "type": "string",
      "description": "Cycle closing date from calendar updated",
      "format": "date",
      "examples": [
        "2021-06-21"
      ]
    },
    "due_date": {
      "type": "string",
      "description": "Due date from calendar updated",
      "format": "date",
      "examples": [
        "2021-06-21"
      ]
    },
    "real_due_date": {
      "type": "string",
      "description": "Real due date from calendar updated",
      "format": "date",
      "examples": [
        "2021-06-21"
      ]
    },
    "best_transaction_day": {
      "type": "string",
      "description": "Best transaction day from calendar updated",
      "format": "date",
      "examples": [
        "2021-06-21"
      ]
    }
  }
}