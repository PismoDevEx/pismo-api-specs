{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Interest redemption account succeeded",
  "description": "This event occurs when a quota is redeemed by value from account with product interest management.",
  "required": [
    "external_redemption_id",
    "external_account_id",
    "created_at",
    "redemption_date",
    "redemption_id",
    "asset_type",
    "scheduled_operation",
    "assets"
  ],
  "properties": {
    "external_redemption_id": {
      "type": "string",
      "title": "External ID",
      "description": "External identifier for operation.",
      "examples": [
        "cf1fb701-186d-426d-ac0f-331f83dfb3ce"
      ]
    },
    "external_account_id": {
      "type": "string",
      "title": "External account identifier",
      "description": "A custom account ID string that uniquely identifies the account within your organization.",
      "examples": [
        "00011122200"
      ]
    },
    "customer_document_number": {
      "type": "string",
      "title": "Customer document number",
      "description": "Number of asset quota owner's legal document",
      "examples": [
        "00000000012"
      ]
    },
    "created_at": {
      "type": "string",
      "title": "Created date",
      "description": "Creation date of asset on Pismo platform",
      "format": "date-time",
      "examples": [
        "2024-01-23T13:26:25"
      ]
    },
    "redemption_date": {
      "type": "string",
      "title": "Redemption date",
      "description": "Date quota was totally/partially redeemed by client",
      "format": "date",
      "examples": [
        "2024-01-22"
      ]
    },
    "redemption_id": {
      "type": "string",
      "title": "Redemption ID",
      "description": "Redemption identifier.",
      "examples": [
        "e5d7523c-a804-40ef-b489-3881d63392f7"
      ]
    },
    "asset_type": {
      "type": "string",
      "title": "Asset type",
      "description": "Financial instrument type",
      "enum": [
        "CDB",
        "RDB"
      ]
    },
    "scheduled_operation": {
      "type": "boolean",
      "title": "Indicates if redemption operation is scheduled",
      "description": "Indicates if redemption operation is scheduled",
      "examples": [
        true,
        false
      ]
    },
    "assets": {
      "type": "array",
      "title": "List of assets",
      "items": {
        "$ref": "#/definitions/asset"
      }
    }
  },
  "definitions": {
    "asset": {
      "type": "object",
      "title": "Asset",
      "description": "Asset.",
      "required": [
        "asset_id",
        "external_asset_id",
        "currency_code",
        "net_redeemed_amount",
        "gross_redeemed_amount",
        "redeemed_units",
        "net_unit_value",
        "gross_unit_value",
        "taxes",
        "remaining_amount"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "title": "Asset ID",
          "description": "Unique asset identifier defined by Pismo.",
          "examples": [
            "2e243c9f-2de6-4cfa-89d9-da871fdb8aab"
          ]
        },
        "external_asset_id": {
          "type": [
            "string",
            "null"
          ],
          "title": "External asset ID",
          "description": "Unique asset short identifier defined by Pismo.",
          "examples": [
            "kxBHNMCAYDnQav"
          ]
        },
        "currency_code": {
          "type": "string",
          "title": "Currency code",
          "description": "ISO 4217 currency code",
          "examples": [
            "986"
          ]
        },
        "net_redeemed_amount": {
          "type": "number",
          "title": "Net Amount Redeemed",
          "description": "Net Value to be redeemed from quota",
          "format": "double",
          "examples": [
            506.8
          ]
        },
        "gross_redeemed_amount": {
          "type": "number",
          "title": "Gross Amount Redeemed",
          "description": "Gross Value to be redeemed from quota",
          "format": "double",
          "examples": [
            508.81
          ]
        },
        "redeemed_units": {
          "type": "number",
          "title": "Redeemed quota units",
          "description": "Number of quota units redeemed by asset quota owner",
          "format": "double",
          "examples": [
            30000
          ]
        },
        "net_unit_value": {
          "type": "number",
          "title": "Net Unit value",
          "description": "Gross value of the asset's units",
          "format": "double",
          "examples": [
            0.01013896
          ]
        },
        "gross_unit_value": {
          "type": "number",
          "title": "Gross Unit value",
          "description": "Net value of the asset's units",
          "format": "double",
          "examples": [
            0.0101793
          ]
        },
        "taxes": {
          "type": "array",
          "title": "List of taxes",
          "items": {
            "$ref": "#/definitions/taxes"
          }
        },
        "remaining_amount": {
          "type": "object",
          "title": "Remaining quota attributes",
          "required": [
            "gross_amount",
            "net_amount",
            "taxes"
          ],
          "description": "Remaining quota available for redemption",
          "properties": {
            "gross_amount": {
              "type": "number",
              "title": "Remaining Gross Amount",
              "description": "Remaining Gross Amount from quota",
              "format": "double",
              "examples": [
                100.0
              ]
            },
            "net_amount": {
              "type": "number",
              "title": "Remaining Net Amount",
              "description": "Remaining Net Amount from quota",
              "format": "double",
              "examples": [
                100.0
              ]
            },
            "taxes": {
              "type": "array",
              "title": "List of taxes of remaining quota",
              "items": {
                "$ref": "#/definitions/remaining_taxes"
              }
            }
          }
        }
      }
    },
    "taxes": {
      "type": "object",
      "title": "Taxes attributes",
      "required": [
        "name",
        "amount",
        "rate"
      ],
      "description": "Taxes to be applied to redemptions",
      "properties": {
        "name": {
          "type": "string",
          "title": "Tax Name",
          "description": "Tax Name.",
          "examples": [
            "IR",
            "IOF"
          ]
        },
        "amount": {
          "type": "number",
          "title": "Tax Amount",
          "description": "Tax Amount.",
          "format": "double",
          "examples": [
            0.15
          ]
        },
        "rate": {
          "type": "number",
          "title": "Tax Rate",
          "description": "Tax Rate.",
          "format": "double",
          "examples": [
            22.5
          ]
        }
      }
    },
    "remaining_taxes": {
      "type": "object",
      "title": "Remaining Taxes attributes",
      "required": [
        "name",
        "amount"
      ],
      "description": "Taxes to be applied to redemptions of remaining quota",
      "properties": {
        "name": {
          "type": "string",
          "title": "Tax Name",
          "description": "Tax Name.",
          "examples": [
            "IR",
            "IOF"
          ]
        },
        "amount": {
          "type": "number",
          "title": "Tax Amount",
          "description": "Tax Amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        }
      }
    }
  }
}