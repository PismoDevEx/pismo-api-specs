{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Pix DICT statistics updated",
  "description": "This event is triggered when a PIX DICT statistics was claimed by the customer. The following endpoints generate this event: <a href='https://developers.pismo.io/pismo-docs/reference/post-dict-statistics'>Request to get the Pix DICT statistics</a>",
  "required": [
    "account_id",
    "status",
    "person_statistics"
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID",
      "examples": [
        123
      ]
    },
    "scheduler_id": {
      "type": "string",
      "title": "Scheduler Identification",
      "description": "The scheduler for the next execution.",
      "examples": [
        "cfdff46e-5d58-45b8-b7aa-591a65f7760d"
      ]
    },
    "next_scheduled_date": {
      "type": "string",
      "title": "Next Scheduled Date",
      "description": "The date and time for the next statistics retrieval execution. If scheduled. A RFC 3339 date value, i.e., '2023-04-12'.",
      "format": "date",
      "examples": [
        "2023-04-12"
      ]
    },
    "updated_at": {
      "type": "string",
      "title": "Timestamping",
      "description": "The statistics persistence timestamp. A RFC 3339 date-time value, i.e., '2023-04-12T23:20:50.52Z'.",
      "format": "date-time",
      "examples": [
        "2021-10-15T16:59:06.389Z"
      ]
    },
    "status": {
      "type": "string",
      "title": "Statistics status",
      "maxLength": 9,
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ],
      "example": "ACTIVE"
    },
    "cid": {
      "type": [
        "string",
        "null"
      ],
      "title": "The Internal Correlation Id",
      "description": "The correlation ID (CID) field is used to link related API requests and events. The CID can help the Pismo engineering team track everything related to a call. You can find the CID field in the response header from an API endpoint call.",
      "examples": [
        "B20211015233837f151ffe5060723e26"
      ]
    },
    "action": {
      "type": "string",
      "title": "Action",
      "description": "Denotates what action has triggered the statistics creation. Example: GET_STATISTICS denotates that was requested directly",
      "example": "GET_STATISTICS"
    },
    "origin": {
      "type": "string",
      "title": "Origin",
      "description": "If present, defines who is calling the statistics.",
      "example": "pix-api"
    },
    "person_statistics": {
      "type": [
        "object",
        "null"
      ],
      "title": "The statistics values",
      "description": "Details of the Pix DICT statistics for the Person.",
      "properties": {
        "correlation_id": {
          "type": [
            "string",
            "null"
          ],
          "title": "The Provider Correlation Id",
          "description": "The correlation ID (CID) field is used to link related API requests and events. The CID can help the Pismo engineering team track everything related to a call. You can find the CID field in the response header from an API endpoint call.",
          "examples": [
            "B20211015233837f151ffe5060723e26"
          ]
        },
        "created_at": {
          "type": "string",
          "title": "Timestamping",
          "description": "The statistics creation from Provider. A RFC 3339 date-time value, i.e., '2023-04-12T23:20:50.52Z'.",
          "format": "date-time",
          "examples": [
            "2021-10-15T16:59:06.389Z"
          ]
        },
        "spi": {
          "type": [
            "object",
            "null"
          ],
          "title": "Provider Info",
          "description": "The statistics returned by Provider.",
          "properties": {
            "settlements": {
              "type": [
                "object",
                "null"
              ],
              "title": "Settlements",
              "description": "Statistics which was in settlement.",
              "properties": {
                "d90": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "title": "90 days",
                  "description": "Total occured in 90 days"
                },
                "m12": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "title": "12 months",
                  "description": "Total occured in 12 months"
                },
