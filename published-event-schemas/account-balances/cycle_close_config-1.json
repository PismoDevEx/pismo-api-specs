{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cycle_close_config-1.json",
  "title": "Cycle closing configuration created",
  "description": "Cycle closing configured by organization, program, or division",
  "type": "object",
  "required": [
    "target_type",
    "target_id",
    "cycle_closing_time"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "ID"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "DIVISION",
        "PROGRAM",
        "ORGANIZATION"
      ],
      "description": "Configuration based on target type"
    },
    "target_id": {
      "type": "string",
      "description": "target ID"
    },
    "cycle_closing_time": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$",
      "description": "Time of day for cycle closing (HH:MM:SS)"
    },
    "cycle_event_delay": {
      "type": "integer",
      "maximum": 59,
      "description": "The time in which the balance history events is sent after `cycle_closing_datetime`. The time is displayed in minutes"
    },
    "cycle_config_validity": {
      "type": "object",
      "title": "Cycle date validity",
      "description": "Cycle closing configuration validity date",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "string",
          "title": "Cycle closing effective date",
          "description": "Configuration effective date in the target's timezone.",
          "maxLength": 25,
          "examples": [
            "2023-02-01T22:07:00-03:00"
          ]
        }
      }
    }
  }
}