{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Overdraft account detached",
  "required": [
    "account_id",
    "attach_datetime",
    "overdraft"
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Your Pismo account ID",
      "examples": [
        123
      ]
    },
    "attach_datetime": {
      "type": "string",
      "format": "date-time",
      "title": "attach datetime",
      "description": "The datetime when the account was attached",
      "examples": [
        "2024-01-23T13:26:25Z"
      ]
    },
    "overdraft": {
      "type": "object",
      "required": [
        "product_id",
        "name",
        "interest_plan_id",
        "processing_codes",
        "status",
        "created_at"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "title": "Product ID",
          "description": "Product ID in UUID v4 format",
          "examples": [
            "2c336e9d-d04f-4fd0-8f6e-25808f48d70c"
          ]
        },
        "name": {
          "type": "string",
          "title": "Product name",
          "description": "Name of the overdraft product",
          "examples": [
            "Tax 1 Default"
          ]
        },
        "interest_plan_id": {
          "type": "string",
          "title": "Interest plan ID",
          "description": "Your interest plan ID on the Pismo platform. The ID is in UUID v4 format.",
          "examples": [
            "b935acaf-886c-4817-8f7c-c2cc3ce4d509"
          ]
        },
        "processing_codes": {
          "type": "object",
          "required": [
            "interest_processing_code"
          ],
          "properties": {
            "interest_processing_code": {
              "type": "string",
              "title": "Interest processing code",
              "description": "Processing code used to identify interest-related transactions such as interest accrual, charging, and reversals on the overdraft balance.",
              "examples": [
                "202526"
              ]
            }
          }
        },
        "status": {
          "type": "string",
          "title": "Status",
          "description": "Current status of the overdraft product",
          "examples": [
            "INACTIVE"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "title": "Created at",
          "description": "The datetime when the overdraft product was created. Represented as a RFC3339 timestamp",
          "examples": [
            "2024-01-23T13:26:25Z"
          ]
        },
        "grace_period": {
          "type": "integer",
          "title": "Grace period",
          "description": "Grace period in days",
          "examples": [
            0
          ]
        }
      }
    },
    "detach_datetime": {
      "type": "string",
      "format": "date-time",
      "title": "detach datetime",
      "description": "The datetime when the account was detached",
      "examples": [
        "2024-03-23T13:26:25Z"
      ]
    },
    "detach_tracking_id": {
      "type": "string",
      "format": "string",
      "title": "detach tracking ID",
      "description": "the detach tracking ID generated when the account was detached",
      "examples": [
        "2c336e9d-b034-4fd0-8f6e-25808f48d70c"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Current status of the attachment",
      "examples": [
        "INACTIVE"
      ]
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "title": "Metadata",
      "description": "Additional information",
      "examples": [
        {
          "key": "value"
        }
      ]
    }
  }
}