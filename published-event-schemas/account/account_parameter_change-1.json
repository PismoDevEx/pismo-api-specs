{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Account parameter changed",
  "description": "This event occurs when an account parameter changes. \n Generated by: <a href='https://developers.pismo.io/pismo-docs/reference/account-parameters-update'>Update account parameter</a>",
  "required": [
    "account_id",
    "parameter_id"
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID.",
      "examples": [
        24146066
      ]
    },
    "parameter_id": {
      "type": "integer",
      "title": "Parameter ID",
      "description": "Program parameter ID.",
      "examples": [
        42
      ]
    },
    "value": {
      "type": "number",
      "title": "New parameter value",
      "description": "New parameter value.",
      "examples": [
        1.84
      ]
    },
    "external_account_id": {
      "type": [
        "string",
        "null"
      ],
      "title": "External account ID",
      "description": "Client-defined external identifier of the account.",
      "maxLength": 60,
      "examples": [
        "ext-abc-123"
      ]
    }
  }
}