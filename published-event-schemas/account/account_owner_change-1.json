{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Account owner changed",
  "description": "This event occurs when the account owner changes. \n Generated by: <a href='https://developers.pismo.io/pismo-docs/reference/customerv2post'>Create customer</a> \n More information: <a href='https://developers.pismo.io/pismo-docs/docs/accounts-overview#account-customers'>Account customers</a>",
  "required": [
    "account_id",
    "old_account_owner",
    "new_account_owner"
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID",
      "examples": [
        100602614
      ]
    },
    "old_account_owner": {
      "type": "object",
      "title": "Old account owner object",
      "description": "Object with old account owner information",
      "properties": {
        "nickname": {
          "type": [
            "string",
            "null"
          ],
          "title": "Old account owner nickname",
          "description": "Old account owner nickname.",
          "maxLength": 128
        },
        "printed_name": {
          "type": [
            "string",
            "null"
          ],
          "title": "Old account owner printed name",
          "description": "Old customer name printed on a card. If `printed_name` is not specified, the platform uses the `social_name` or `name` to create the `printed_name`.",
          "maxLength": 25,
          "examples": [
            "Maria M Silva"
          ]
        },
        "social_name": {
          "type": [
            "string",
            "null"
          ],
          "title": "Old account owner social name",
          "description": "Old account owner social name.",
          "maxLength": 64,
          "examples": [
            "Maria"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "title": "Old account owner email address",
          "description": "Old account owner email address.",
          "maxLength": 255,
          "examples": [
            "customer@domain.com"
          ]
        },
        "is_active": {
          "type": "boolean",
          "title": "Old account owner active flag",
          "description": "Old flag that indicates whether the account owner is active.",
          "examples": [
            false,
            true
          ]
        }
      }
    },
    "new_account_owner": {
      "type": "object",
      "title": "New account owner  object",
      "description": "Object with new account owner information",
      "properties": {
        "nickname": {
          "type": [
            "string",
            "null"
          ],
          "title": "New account owner nickname",
          "description": "New account owner nickname.",
          "maxLength": 128
        },
        "printed_name": {
          "type": [
            "string",
            "null"
          ],
          "title": "New account owner printed name",
          "description": "New account owner name printed on a card. If `printed_name` is not provided, the platform uses the `social_name` or `name` to create the `printed_name`.",
          "maxLength": 25,
          "examples": [
            "Maria M Silva"
          ]
        },
        "social_name": {
          "type": [
            "string",
            "null"
          ],
          "title": "New account owner social name",
          "description": "New account owner social name.",
          "maxLength": 64,
          "examples": [
            "Maria"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "title": "New account owner email address",
          "description": "New account owner email address.",
          "maxLength": 255,
          "examples": [
            "customer@domain.com"
          ]
        },
        "is_active": {
          "type": "boolean",
          "title": "New account owner active flag",
          "description": "Is customer active?",
          "examples": [
            false,
            true
          ]
        }
      }
    },
    "external_account_id": {
      "type": [
        "string",
        "null"
      ],
      "title": "External account ID",
      "description": "Client-defined external identifier of the account.",
      "maxLength": 60,
      "examples": [
        "ext-abc-123"
      ]
    }
  }
}