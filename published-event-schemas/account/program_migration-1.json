{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Account migrated to different program",
  "description": "This event occurs when an account migrates from one program on the Pismo platform to another. \n Generated by: <a href='https://developers.pismo.io/pismo-docs/reference/postmigrationprogram'>Transfer account to different program</a> \n More information: <a href='https://developers.pismo.io/pismo-docs/docs/accounts-overview#migrate-account-to-different-program'>Migrate account to different program</a>",
  "required": [
    "account_id",
    "old_program_id",
    "new_program_id"
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID.",
      "examples": [
        8675309
      ]
    },
    "old_program_id": {
      "type": "integer",
      "title": "Old program ID",
      "description": "Old program ID.",
      "examples": [
        10
      ]
    },
    "new_program_id": {
      "type": "integer",
      "title": "New program ID",
      "description": "New program ID.",
      "examples": [
        20
      ]
    },
    "external_account_id": {
      "type": [
        "string",
        "null"
      ],
      "title": "External account ID",
      "description": "Client-defined external identifier of the account.",
      "maxLength": 60,
      "examples": [
        "ext-abc-123"
      ]
    }
  }
}