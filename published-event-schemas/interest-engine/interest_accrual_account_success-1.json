{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Interest accrual account succeeded",
  "description": "This event occurs when a deposit quota is accrued with product interest engine.",
  "required": [
    "org_id",
    "program_id",
    "account_id",
    "accrual_date",
    "balance_without_interest",
    "interest_gross_amount",
    "interest_net_amount",
    "net_balance",
    "gross_balance",
    "accrual_daily_net_amount",
    "accrual_daily_gross_amount"
  ],
  "properties": {
    "org_id": {
      "type": "string",
      "title": "Org ID",
      "description": "Unique organization identifier",
      "examples": [
        "08102A0B-D4F8-42A2-8B0E-2052D05577D7"
      ]
    },
    "program_id": {
      "type": [
        "string",
        "null"
      ],
      "title": "Program ID",
      "description": "Unique program identifier",
      "examples": [
        "1234"
      ]
    },
    "account_id": {
      "type": "string",
      "title": "Pismo's account identifier",
      "description": "Account ID generated by Pismo's platform that uniquely identifies an account within your organization.",
      "examples": [
        "999999999"
      ]
    },
    "external_account_id": {
      "type": "string",
      "title": "Client's account identifier",
      "description": "External account ID informed by the client that uniquely identifies an account within your organization.",
      "examples": [
        "account-xyz-987"
      ]
    },
    "accrual_date": {
      "type": "string",
      "title": "Accrual date",
      "description": "Date asset was effectively issued by client.",
      "format": "date",
      "examples": [
        "2020-12-01"
      ]
    },
    "balance_without_interest": {
      "type": "number",
      "title": "Balance Without Interest",
      "description": "Balance Without Interest",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "interest_gross_amount": {
      "type": "number",
      "title": "Interest Net Amount",
      "description": "Interest Net Amount from quota",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "interest_net_amount": {
      "type": "number",
      "title": "Interest Net Amount",
      "description": "Interest Net Amount from quota",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "net_balance": {
      "type": "number",
      "title": "Accrual Net Amount",
      "description": "Actual net value.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "gross_balance": {
      "type": "number",
      "title": "Accrual Gross Amount",
      "description": "Accrual Gross Amount.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "accrual_daily_net_amount": {
      "type": "number",
      "title": "Accrual Daily Net Amount",
      "description": "Accrual Daily Net Amount.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "accrual_daily_gross_amount": {
      "type": "number",
      "title": "Accrual Daily Gross Amount",
      "description": "Accrual Daily Gross Amount.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "division_id": {
      "type": "string",
      "title": "Division ID",
      "description": "Unique division identifier",
      "examples": [
        "123"
      ]
    },
    "division_code": {
      "type": "string",
      "title": "Division Code",
      "description": "Division code",
      "examples": [
        "123"
      ]
    },
    "taxes": {
      "type": "array",
      "title": "List of taxes",
      "items": {
        "$ref": "#/definitions/taxes"
      }
    },
    "deposits": {
      "type": "array",
      "title": "List of deposits",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/deposits"
      }
    }
  },
  "definitions": {
    "deposits": {
      "type": "object",
      "title": "Deposit",
      "description": "Deposits.",
      "required": [
        "tracking_id",
        "net_balance",
        "gross_balance",
        "balance_without_interest",
        "interest_gross_amount",
        "interest_net_amount",
        "accrual_daily_net_amount",
        "accrual_daily_gross_amount",
        "taxes"
      ],
      "properties": {
        "tracking_id": {
          "type": [
            "string",
            "null"
          ],
          "title": "Tracking ID",
          "description": "Unique identifier defined by client. It can be used to redeem quotas.",
          "examples": [
            "d0855c6b-b037-4dce-94c5-7a6ffc1800a3"
          ]
        },
        "net_balance": {
          "type": "number",
          "title": "Net Balance",
          "description": "Interest Net Amount from quota.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "gross_balance": {
          "type": "number",
          "title": "Gross Balance",
          "description": "Interest Gross Amount from quota.",
          "format": "double",
          "examples": [
            100.15
          ]
        },
        "balance_without_interest": {
          "type": "number",
          "title": "Balance Without Interest",
          "description": "Balance without interest.",
          "format": "double",
          "examples": [
            100.15
          ]
        },
        "interest_gross_amount": {
          "type": "number",
          "title": "Interest Gross Amount",
          "description": "Interest Gross Amount from quota",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "interest_net_amount": {
          "type": "number",
          "title": "Interest Net Amount",
          "description": "Interest Net Amount from quota",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "accrual_daily_net_amount": {
          "type": "number",
          "title": "Accrual Daily Net Amount",
          "description": "Accrual Accum Net Amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "accrual_daily_gross_amount": {
          "type": "number",
          "title": "Accrual Daily Gross Amount",
          "description": "Accrual Accum Gross Amount.",
          "format": "double",
          "examples": [
            100.15
          ]
        },
        "taxes": {
          "type": "array",
          "title": "List of taxes",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/taxes"
          }
        }
      }
    },
    "taxes": {
      "type": "object",
      "title": "Tax",
      "description": "Tax.",
      "required": [
        "name",
        "unit_value",
        "rate",
        "amount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Tax Name",
          "description": "Tax Name.",
          "examples": [
            "IR",
            "IOF"
          ]
        },
        "unit_value": {
          "type": "number",
          "title": "Tax Unit Value",
          "description": "Tax unit value (rate-based, high precision).",
          "format": "double",
          "examples": [
            0.05
          ]
        },
        "amount": {
          "type": "number",
          "title": "Tax Amount",
          "description": "Tax Amount.",
          "format": "double",
          "examples": [
            0.15
          ]
        },
        "rate": {
          "type": "number",
          "title": "Tax Rate",
          "description": "Tax Rate.",
          "format": "double",
          "examples": [
            22.5
          ]
        }
      }
    }
  }
}