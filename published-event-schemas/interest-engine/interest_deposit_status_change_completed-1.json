{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Deposit status changed to completed",
  "description": "This event occurs when an asset's status changes to `completed` with product interest engine.",
  "required": [
    "org_id",
    "program_id",
    "asset_id",
    "external_asset_id",
    "status",
    "updated_at"
  ],
  "properties": {
    "org_id": {
      "type": "string",
      "title": "Org ID",
      "description": "Unique organization identifier",
      "examples": [
        "08102A0B-D4F8-42A2-8B0E-2052D05577D7"
      ]
    },
    "program_id": {
      "type": "string",
      "title": "Program ID",
      "description": "Unique program identifier",
      "examples": [
        "1234"
      ]
    },
    "asset_id": {
      "type": [
        "string",
        "null"
      ],
      "title": "Asset ID",
      "description": "Unique asset identifier defined by Pismo.",
      "examples": [
        "d0855c6b-b037-4dce-94c5-7a6ffc1800a3"
      ]
    },
    "external_asset_id": {
      "type": [
        "string",
        "null"
      ],
      "title": "External asset ID",
      "description": "Unique asset short identifier defined by Pismo.",
      "examples": [
        "kxBHNMCAYDnQav"
      ]
    },
    "status": {
      "type": "string",
      "title": "Asset status",
      "description": "Status of asset",
      "enum": [
        "COMPLETED"
      ]
    },
    "updated_at": {
      "type": "string",
      "title": "Updated date",
      "description": "Date asset was last updated",
      "format": "date-time",
      "examples": [
        "2020-12-29T19:48:25"
      ]
    },
    "deposits": {
      "type": "array",
      "title": "List of deposits",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/deposit"
      }
    }
  },
  "definitions": {
    "deposit": {
      "type": "object",
      "title": "Deposit",
      "description": "Deposit.",
      "required": [
        "tracking_id",
        "account_id",
        "issuing_date",
        "maturity_date",
        "issued_units",
        "current_units",
        "net_unit_value",
        "gross_unit_value",
        "net_amount",
        "gross_amount",
        "interest_gross_amount",
        "interest_net_amount",
        "taxes"
      ],
      "properties": {
        "tracking_id": {
          "type": "string",
          "title": "Tracking ID",
          "description": "Unique identifier defined by client. It can be used to redeem quotas.",
          "examples": [
            "d0855c6b-b037-4dce-94c5-7a6ffc1800a3"
          ]
        },
        "account_id": {
          "type": "string",
          "title": "Pismo's account identifier",
          "description": "Account ID generated by Pismo's platform that uniquely identifies an account within your organization.",
          "examples": [
            "00011122200"
          ]
        },
        "issuing_date": {
          "type": "string",
          "title": "Issuing date",
          "description": "Date asset was effectively issued by client.",
          "format": "date",
          "examples": [
            "2020-12-01"
          ]
        },
        "maturity_date": {
          "type": "string",
          "title": "Maturity date",
          "description": "Date asset expires, finishing `issued_units` cycle.",
          "format": "date",
          "examples": [
            "2022-12-01"
          ]
        },
        "issued_units": {
          "type": [
            "number",
            "null"
          ],
          "title": "Issued units",
          "description": "Number of units asset can support.",
          "examples": [
            10000
          ]
        },
        "current_units": {
          "type": [
            "number",
            "null"
          ],
          "title": "Current units",
          "description": "Number of units asset has.",
          "examples": [
            10000
          ]
        },
        "net_unit_value": {
          "type": [
            "number",
            "null"
          ],
          "title": "Net Unit Value",
          "description": "Accrued net unit value by quota.",
          "format": "double",
          "examples": [
            0.01000085
          ]
        },
        "gross_unit_value": {
          "type": [
            "number",
            "null"
          ],
          "title": "Gross Unit Value",
          "description": "Accrued gross unit value by quota.",
          "format": "double",
          "examples": [
            0.01001575
          ]
        },
        "net_amount": {
          "type": "number",
          "title": "Accrual Accum Net Amount",
          "description": "Accrual Accum Net Amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "gross_amount": {
          "type": "number",
          "title": "Accrual Accum Gross Amount",
          "description": "Accrual Accum Gross Amount.",
          "format": "double",
          "examples": [
            100.15
          ]
        },
        "interest_gross_amount": {
          "type": "number",
          "title": "Interest Gross Amount",
          "description": "Interest Gross Amount from quota",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "interest_net_amount": {
          "type": "number",
          "title": "Interest Net Amount",
          "description": "Interest Net Amount from quota",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "taxes": {
          "type": [
            "array",
            "null"
          ],
          "title": "List of taxes",
          "items": {
            "$ref": "#/definitions/tax"
          }
        }
      }
    },
    "tax": {
      "type": "object",
      "title": "Tax",
      "description": "Tax.",
      "required": [
        "name",
        "amount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Tax Name",
          "description": "Tax Name.",
          "examples": [
            "IR",
            "IOF"
          ]
        },
        "amount": {
          "type": "number",
          "title": "Tax Amount",
          "description": "Tax Amount.",
          "format": "double",
          "examples": [
            0.15
          ]
        }
      }
    }
  }
}