{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Interest capitalization account succeeded [Beta]",
  "description": "This event occurs when a capitalization is available with product interest engine.",
  "required": [
    "org_id",
    "program_id",
    "account_id",
    "capitalization_date",
    "balance_without_interest",
    "net_balance",
    "gross_balance",
    "interest_gross_amount",
    "interest_net_amount",
    "operation_type",
    "gross_interest_year_to_date",
    "taxes"
  ],
  "properties": {
    "org_id": {
      "$id": "#/properties/org_id",
      "title": "Organization ID",
      "description": "Organization/tenant ID.",
      "type": "string",
      "examples": [
        "TN-1234"
      ]
    },
    "program_id": {
      "type": "string",
      "title": "Program identification",
      "description": "Program ID to which the account belongs within your organization.",
      "examples": [
        "12345678"
      ]
    },
    "account_id": {
      "type": "string",
      "title": "Pismo's account identifier",
      "description": "Account ID generated by Pismo's platform that uniquely identifies an account within your organization.",
      "examples": [
        "999999999"
      ]
    },
    "external_account_id": {
      "type": "string",
      "title": "Client's account identifier",
      "description": "External account ID informed by the client that uniquely identifies an account within your organization.",
      "examples": [
        "account-xyz-987"
      ]
    },
    "capitalization_date": {
      "type": "string",
      "title": "Capitalization date",
      "description": "Date when the capitalization occurs.",
      "format": "date",
      "examples": [
        "2020-12-01"
      ]
    },
    "balance_without_interest": {
      "type": "number",
      "title": "Balance without interest",
      "description": "Balance value without interest.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "net_balance": {
      "type": "number",
      "title": "Capitalization net amount",
      "description": "Capitalization net value.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "gross_balance": {
      "type": "number",
      "title": "Capitalization gross amount",
      "description": "Capitalization Gross Amount.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "interest_gross_amount": {
      "type": "number",
      "title": "Interest gross amount",
      "description": "Capitalization interest gross amount.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "interest_net_amount": {
      "type": "number",
      "title": "Interest net Amount",
      "description": "Capitalization interest net Amount.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "operation_type": {
      "type": [
        "string",
        "null"
      ],
      "title": "Operation type",
      "description": "Type of interest calculation by tiers.",
      "examples": [
        "CREDIT",
        "DEBIT"
      ]
    },
    "gross_interest_year_to_date": {
      "type": "number",
      "title": "Gross interest year to date",
      "description": "Sum of gross capitalized interest accumulated for the account in the current year, up to and including the current capitalization event.",
      "format": "double",
      "examples": [
        1450.75
      ]
    },
    "division_id": {
      "type": "string",
      "title": "Division ID",
      "description": "Unique division identifier",
      "examples": [
        "123"
      ]
    },
    "division_code": {
      "type": "string",
      "title": "Division Code",
      "description": "Division code",
      "examples": [
        "123"
      ]
    },
    "taxes": {
      "type": "array",
      "title": "List of taxes",
      "items": {
        "$ref": "#/definitions/taxes"
      }
    },
    "deposits": {
      "type": "array",
      "title": "List of deposits",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/deposits"
      }
    },
    "tax_rules": {
      "type": "array",
      "title": "Tax Rules",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/tax_rule"
      }
    },
    "interest_details": {
      "$ref": "#/definitions/interest_details"
    }
  },
  "definitions": {
    "interest_details": {
      "type": "object",
      "title": "Interest details",
      "description": "Present only when this account has a pending, not-yet-emitted delta from one or more backdated (RETROACTIVE_CYCLE_CLOSING) corrections. Breaks down interest_gross_amount/interest_net_amount into the regular (non-backdated) portion and the accumulated backdated adjustment that was folded into this event.",
      "required": [
        "REGULAR_AMOUNT",
        "BACKDATED_ADJUSTMENT"
      ],
      "properties": {
        "REGULAR_AMOUNT": {
          "$ref": "#/definitions/interest_details_regular_amount"
        },
        "BACKDATED_ADJUSTMENT": {
          "$ref": "#/definitions/interest_details_backdated_adjustment"
        }
      }
    },
    "interest_details_regular_amount": {
      "type": "object",
      "title": "Regular amount",
      "description": "Interest amount from the normal, non-backdated accrual calculation, before adding the backdated adjustment.",
      "required": [
        "gross_amount",
        "net_amount"
      ],
      "properties": {
        "gross_amount": {
          "type": "number",
          "title": "Gross amount",
          "description": "Regular gross interest amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "net_amount": {
          "type": "number",
          "title": "Net amount",
          "description": "Regular net interest amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        }
      }
    },
    "interest_details_backdated_adjustment": {
      "type": "object",
      "title": "Backdated adjustment",
      "description": "Accumulated delta from one or more backdated (RETROACTIVE_CYCLE_CLOSING) corrections, emitted together with this event.",
      "required": [
        "delta_gross_amount",
        "delta_net_amount"
      ],
      "properties": {
        "delta_gross_amount": {
          "type": "number",
          "title": "Delta gross amount",
          "description": "Total gross delta added to interest_gross_amount by the backdated correction(s).",
          "format": "double",
          "examples": [
            12.5
          ]
        },
        "delta_net_amount": {
          "type": "number",
          "title": "Delta net amount",
          "description": "Total net delta added to interest_net_amount by the backdated correction(s).",
          "format": "double",
          "examples": [
            12.5
          ]
        }
      }
    },
    "deposits": {
      "type": "object",
      "title": "Deposit",
      "description": "Deposit",
      "required": [
        "tracking_id",
        "balance_without_interest",
        "net_balance",
        "gross_balance",
        "interest_gross_amount",
        "interest_net_amount",
        "taxes"
      ],
      "properties": {
        "tracking_id": {
          "type": "string",
          "title": "Tracking ID.",
          "description": "Unique deposit identifier defined by Customer.",
          "examples": [
            "d0855c6b-b037-4dce-94c5-7a6ffc1800a3"
          ]
        },
        "balance_without_interest": {
          "type": "number",
          "title": "Accrual Net Amount",
          "description": "Balance value without interest.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "net_balance": {
          "type": "number",
          "title": "Capitalization Net Amount",
          "description": "Capitalization net value.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "gross_balance": {
          "type": "number",
          "title": "Capitalization Gross Amount",
          "description": "Capitalization Gross Amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "interest_gross_amount": {
          "type": "number",
          "title": "Interest gross amount",
          "description": "Capitalization interest gross amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "interest_net_amount": {
          "type": "number",
          "title": "Interest net Amount",
          "description": "Capitalization interest net Amount.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "taxes": {
          "type": "array",
          "title": "List of taxes",
          "items": {
            "$ref": "#/definitions/taxes"
          }
        }
      }
    },
    "taxes": {
      "type": "object",
      "title": "Tax",
      "description": "Tax.",
      "required": [
        "name",
        "amount",
        "rate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Tax Name",
          "description": "Tax Name.",
          "examples": [
            "IR",
            "IOF"
          ]
        },
        "amount": {
          "type": "number",
          "title": "Tax Amount",
          "description": "Tax Amount.",
          "format": "double",
          "examples": [
            0.15
          ]
        },
        "rate": {
          "type": "number",
          "title": "Tax Rate",
          "description": "Tax Rate.",
          "format": "double",
          "examples": [
            22.5
          ]
        }
      }
    },
    "tax_rule": {
      "type": "object",
      "title": "Tax Rule",
      "description": "Individual tax rule configuration.",
      "required": [
        "description",
        "fixed_percentage"
      ],
      "properties": {
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Description of the tax rule.",
          "maxLength": 128,
          "examples": [
            "Federal Tax"
          ]
        },
        "fixed_percentage": {
          "type": "number",
          "format": "double",
          "title": "Fixed Percentage",
          "description": "Fixed percentage rate for this tax rule.",
          "examples": [
            0.05,
            0.1
          ]
        },
        "threshold_amount": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "title": "Threshold Amount",
          "description": "Amount threshold above which this tax rule applies.",
          "examples": [
            1500.0
          ]
        }
      }
    }
  }
}