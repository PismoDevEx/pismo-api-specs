{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Interest account maturity [Beta]",
  "description": "This event occurs when an interest account reaches its configured maturity date with product interest engine. It carries account-level and deposit-level maturity balances. Published in parallel with `interest_deposit_status_change_completed` during consumer migration.",
  "required": [
    "org_id",
    "program_id",
    "account_id",
    "status",
    "updated_at",
    "maturity_date",
    "balance_without_interest",
    "net_balance",
    "gross_balance",
    "interest_gross_amount",
    "interest_net_amount"
  ],
  "properties": {
    "org_id": {
      "type": "string",
      "title": "Org ID",
      "description": "Unique organization identifier",
      "examples": [
        "08102A0B-D4F8-42A2-8B0E-2052D05577D7"
      ]
    },
    "program_id": {
      "type": "string",
      "title": "Program ID",
      "description": "Unique program identifier",
      "examples": [
        "1234"
      ]
    },
    "division_id": {
      "type": "string",
      "title": "Division ID",
      "description": "Unique division identifier",
      "examples": [
        "1234"
      ]
    },
    "division_code": {
      "type": "string",
      "title": "Division code ID",
      "description": "Code string that uniquely identifies the division within your organization.",
      "maxLength": 36,
      "examples": [
        "PRIVATE_BANKING"
      ]
    },
    "account_id": {
      "type": "string",
      "title": "Pismo's account identifier",
      "description": "Account ID generated by Pismo's platform that uniquely identifies an account within your organization.",
      "examples": [
        "123456"
      ]
    },
    "external_account_id": {
      "type": "string",
      "title": "Client's account identifier",
      "description": "External account ID informed by the client that uniquely identifies an account within your organization.",
      "examples": [
        "account-xyz-987"
      ]
    },
    "status": {
      "type": "string",
      "title": "Account status",
      "description": "Status of account",
      "enum": [
        "MATURED"
      ]
    },
    "updated_at": {
      "type": "string",
      "title": "Updated date",
      "description": "Date account was last updated",
      "format": "date-time",
      "examples": [
        "2020-12-29T19:48:25"
      ]
    },
    "maturity_date": {
      "type": "string",
      "title": "Maturity date",
      "description": "Date that the balance expires, finishing rentability cycle.",
      "format": "date",
      "examples": [
        "2022-12-01"
      ]
    },
    "balance_without_interest": {
      "type": "number",
      "title": "Balance without interest",
      "description": "Balance value without interest.",
      "format": "double",
      "examples": [
        100.0
      ]
    },
    "net_balance": {
      "type": "number",
      "title": "Net balance",
      "description": "Balance after interest and taxes.",
      "format": "double",
      "examples": [
        100.1
      ]
    },
    "gross_balance": {
      "type": "number",
      "title": "Gross balance",
      "description": "Balance before tax deductions.",
      "format": "double",
      "examples": [
        100.15
      ]
    },
    "interest_gross_amount": {
      "type": "number",
      "title": "Interest gross amount",
      "description": "Gross interest accrued.",
      "format": "double",
      "examples": [
        0.15
      ]
    },
    "interest_net_amount": {
      "type": "number",
      "title": "Interest net amount",
      "description": "Net interest after taxes.",
      "format": "double",
      "examples": [
        0.1
      ]
    },
    "taxes": {
      "$ref": "#/definitions/tax"
    },
    "deposits": {
      "type": "array",
      "title": "List of deposits",
      "description": "Deposit-level maturity breakdown.",
      "items": {
        "$ref": "#/definitions/deposit"
      }
    }
  },
  "definitions": {
    "deposit": {
      "type": "object",
      "title": "Deposit",
      "description": "Deposit-level maturity balances.",
      "required": [
        "tracking_id",
        "balance_without_interest",
        "net_balance",
        "gross_balance",
        "interest_gross_amount",
        "interest_net_amount"
      ],
      "properties": {
        "tracking_id": {
          "type": "string",
          "title": "Tracking ID.",
          "description": "Unique deposit identifier defined by Customer.",
          "examples": [
            "d0855c6b-b037-4dce-94c5-7a6ffc1800a3"
          ]
        },
        "balance_without_interest": {
          "type": "number",
          "title": "Balance without interest",
          "description": "Balance value without interest.",
          "format": "double",
          "examples": [
            100.0
          ]
        },
        "net_balance": {
          "type": "number",
          "title": "Net balance",
          "description": "Balance after interest and taxes.",
          "format": "double",
          "examples": [
            100.1
          ]
        },
        "gross_balance": {
          "type": "number",
          "title": "Gross balance",
          "description": "Balance before tax deductions.",
          "format": "double",
          "examples": [
            100.15
          ]
        },
        "interest_gross_amount": {
          "type": "number",
          "title": "Interest gross amount",
          "description": "Gross interest accrued.",
          "format": "double",
          "examples": [
            0.15
          ]
        },
        "interest_net_amount": {
          "type": "number",
          "title": "Interest net amount",
          "description": "Net interest after taxes.",
          "format": "double",
          "examples": [
            0.1
          ]
        },
        "taxes": {
          "$ref": "#/definitions/tax"
        }
      }
    },
    "tax": {
      "type": "object",
      "title": "Tax",
      "description": "Tax applied to the balance. Omitted when no tax applies.",
      "required": [
        "name",
        "amount",
        "rate"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Tax Name",
          "description": "Tax Name.",
          "examples": [
            "IR",
            "IOF"
          ]
        },
        "amount": {
          "type": "number",
          "title": "Tax Amount",
          "description": "Tax Amount.",
          "format": "double",
          "examples": [
            0.05
          ]
        },
        "rate": {
          "type": "number",
          "title": "Tax Rate",
          "description": "Tax Rate.",
          "format": "double",
          "examples": [
            22.5
          ]
        }
      }
    }
  }
}