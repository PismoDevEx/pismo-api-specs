{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Financial transaction status updated.",
  "description": "Financial transaction status updated. The [Cash-out transfer](https://developers.pismo.io/pismo-docs/reference/post-integrated-payments-api-v1-bankslips-cashout) endpoint generates this event.",
  "required": [
    "account_id",
    "authorization_id",
    "new_status",
    "old_status"
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID",
      "examples": [
        31700
      ]
    },
    "authorization_id": {
      "type": "integer",
      "title": "Authorization ID",
      "description": "Pismo authorization ID",
      "examples": [
        123
      ]
    },
    "new_status": {
      "type": "string",
      "title": "New status",
      "description": "New transaction status",
      "examples": [
        "PROCESSING",
        "SETTLED",
        "CANCELLED",
        "ERROR"
      ]
    },
    "old_status": {
      "type": "string",
      "title": "Old status",
      "description": "Old transaction status",
      "examples": [
        "PROCESSING",
        "SETTLED",
        "CANCELLED",
        "ERROR"
      ]
    }
  }
}