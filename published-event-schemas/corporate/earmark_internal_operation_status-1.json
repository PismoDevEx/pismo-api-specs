{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Earmark internal operation execution tracking",
  "required": [
    "earmark_id",
    "tracking_id",
    "operation",
    "status",
    "processing_code",
    "amount",
    "currency",
    "force_post"
  ],
  "properties": {
    "earmark_id": {
      "type": "string",
      "title": "Earmark unique identifier generated by Pismo",
      "minLength": 1,
      "maxLength": 60,
      "examples": [
        "8490b160-6a41-466e-917f-12c0fd8e998e"
      ]
    },
    "tracking_id": {
      "title": "A unique identifier for the internal operation",
      "type": "string",
      "minLength": 1,
      "maxLength": 75,
      "examples": [
        "UK1-eb75c472-a213-41a7-a96e-ac0156b832f0"
      ]
    },
    "business_date": {
      "type": "string",
      "title": "Business date",
      "description": "The internal operation business date.",
      "format": "date",
      "examples": [
        "2023-02-06"
      ]
    },
    "operation": {
      "type": "string",
      "title": "Internal operation type",
      "description": "\n\nIt only accepts the values:\n\n`RELEASE_FUNDS`: When the internal operation in releasing funds.",
      "minLength": 1,
      "maxLength": 20,
      "enum": [
        "RELEASE_FUNDS"
      ],
      "examples": [
        "RELEASE_FUNDS"
      ]
    },
    "status": {
      "type": "string",
      "title": "Internal operation execution status",
      "description": "\n\nIt only accepts the values:\n\n`FAILED`:When the internal operation failed..",
      "minLength": 1,
      "maxLength": 20,
      "enum": [
        "FAILED"
      ],
      "examples": [
        "FAILED"
      ]
    },
    "processing_code": {
      "type": "string",
      "title": "Processing code",
      "minLength": 1,
      "maxLength": 6,
      "examples": [
        "219251"
      ]
    },
    "amount": {
      "type": "number",
      "title": "Earmark amount",
      "minimum": 0.01,
      "maximum": 18446744073709551617,
      "examples": [
        10.1,
        100.2,
        30
      ]
    },
    "currency": {
      "type": "string",
      "title": "Currency alphabetic code",
      "description": "A 3-letter code in the ISO 4217-compliant format that represents the currency used in the transaction.",
      "minLength": 1,
      "maxLength": 3,
      "examples": [
        "USD",
        "BRL"
      ]
    },
    "force_post": {
      "type": "boolean",
      "title": "Force Post",
      "examples": [
        false
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "title": "Error",
      "description": "Contains error data",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "title": "Error Code",
          "minLength": 1,
          "maxLength": 12,
          "examples": [
            "WEAM0005"
          ]
        },
        "message": {
          "type": "string",
          "title": "Error Message",
          "minLength": 1,
          "maxLength": 100,
          "examples": [
            "Invalid account status"
          ]
        }
      }
    }
  }
}