{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "title": "Scheduled payment created or modified",
  "description": "This event occurs when the platform creates or modifies a scheduled payment. For a new scheduled payment, the value in the `status` field is `CREATED`. For changes on the existing scheduled payment, the `status` field reflects the corresponding status. <br><br>Generated by: <a href='https://developers.pismo.io/pismo-docs/reference/post-pre-schedules' target='_blank'>Create pre-schedule</a> <br>More information: <a href='https://developers.pismo.io/pismo-docs/docs/payment-scheduler' target='_blank'>Payment scheduler</a>",
  "required": [
    "account_id",
    "schedule_id",
    "schedule_kind",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schedule_kind": {
            "const": "SINGLE"
          }
        }
      },
      "then": {
        "required": [
          "amount",
          "processing_code",
          "currency",
          "schedule_details"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/amount"
          },
          "processing_code": {
            "$ref": "#/definitions/processing_code"
          },
          "currency": {
            "$ref": "#/definitions/currency"
          },
          "schedule_details": {
            "$ref": "#/definitions/schedule_details"
          },
          "restrictions": {
            "$ref": "#/definitions/restrictions"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schedule_kind": {
            "const": "TRANSFERS"
          }
        }
      },
      "then": {
        "required": [
          "transfers",
          "schedule_details"
        ],
        "properties": {
          "transfers": {
            "$ref": "#/definitions/transfers"
          },
          "strategy": {
            "$ref": "#/definitions/strategy"
          },
          "schedule_details": {
            "$ref": "#/definitions/schedule_details"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schedule_kind": {
            "const": "PRE"
          }
        }
      },
      "then": {
        "required": [
          "amount",
          "processing_code",
          "currency",
          "schedule_details"
        ],
        "properties": {
          "amount": {
            "$ref": "#/definitions/amount"
          },
          "processing_code": {
            "$ref": "#/definitions/processing_code"
          },
          "currency": {
            "$ref": "#/definitions/currency"
          },
          "schedule_details": {
            "$ref": "#/definitions/pre_schedule_details"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schedule_kind": {
            "const": "SCRAPING"
          }
        }
      },
      "then": {
        "required": [
          "processing_codes",
          "schedule_details"
        ],
        "properties": {
          "processing_codes": {
            "$ref": "#/definitions/processing_codes"
          },
          "schedule_details": {
            "$ref": "#/definitions/scraping_schedule_details"
          },
          "scraping_details": {
            "$ref": "#/definitions/scraping_details"
          },
          "restrictions": {
            "$ref": "#/definitions/restrictions_scraping"
          }
        }
      }
    }
  ],
  "properties": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID",
      "examples": [
        100602614
      ]
    },
    "schedule_id": {
      "type": "string",
      "title": "Schedule ID",
      "description": "Schedule ID",
      "examples": [
        "9cd6485a-5680-4df0-a1f1-507e21d3428c"
      ]
    },
    "schedule_kind": {
      "type": "string",
      "title": "Schedule kind",
      "description": "Schedule kind: `SINGLE` (for one account), `MULTIPLE` (for two or more accounts, with one main parent account and one or more children accounts), `PRE` (for pre-scheduling that requires an external execution trigger), or SCRAPING (for a scraping account operation)",
      "enum": [
        "SINGLE",
        "MULTIPLE",
        "PRE",
        "SCRAPING"
      ],
      "examples": [
        "SINGLE"
      ]
    },
    "status": {
      "type": "string",
      "title": "Status",
      "description": "Schedule status. For a new scheduled payment, the value in the `status` field is `CREATED`. For changes on the existing scheduled payment, the `status` field reflects the corresponding status.",
      "enum": [
        "CREATED",
        "UPDATED",
        "IN_PROGRESS",
        "CANCELED",
        "SUSPENDED",
        "COMPLETED"
      ],
      "examples": [
        "CREATED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created date",
      "description": "Created date of the schedule in UTC-0 (RFC3339) format, which includes milliseconds (yyyy-MM-ddThh:mm:ss.SSSZ).",
      "examples": [
        "2024-01-01T00:00:00.000Z"
      ]
    },
    "description": {
      "type": "string",
      "title": "Schedule description",
      "description": "Schedule description.",
      "examples": [
        "Monthly purchase",
        "Daily purchase"
      ]
    },
    "metadata": {
      "type": "object",
      "title": "Metadata",
      "description": "Additional information relevant to the customer. No business rule validation is performed on it.",
      "examples": [
        {
          "metadata": {
            "customer-data": {
              "any": "fields"
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "account_id": {
      "type": "integer",
      "title": "Account ID",
      "description": "Pismo account ID",
      "examples": [
        100602614
      ]
    },
    "restrictions": {
      "type": "object",
      "title": "Restrictions object",
      "description": "Object with information about schedule restrictions",
      "properties": {
        "minimum_daily_available": {
          "type": "number",
          "title": "Minimum daily available amount.",
          "description": "Execute the schedule if the available account limit is less than this configured value",
          "examples": [
            25.75,
            125.0,
            57.25
          ]
        },
        "minimum_monthly_average_available": {
          "type": "number",
          "title": "Minimum monthly average available amount",
          "description": "Execute the schedule if the average of monthly account limits is less than this configured value. The platform calculates the average from the current month until one day before the schedule execution date (d-1).",
          "examples": [
            25.75,
            125.0,
            57.25
          ]
        },
        "minimum_days_account_inactivity": {
          "type": "integer",
          "title": "Minimum days account inactivity",
          "description": "Execute the schedule if the account doesn't have any financial activity within the number of configured days",
          "examples": [
            1,
            2,
            3
          ]
        }
      }
    },
    "restrictions_scraping": {
      "type": "object",
      "title": "Restrictions object",
      "description": "Object with information about schedule restrictions",
      "properties": {
        "minimum_available": {
          "type": "number",
          "title": "Minimum daily available amount",
          "description": "Execute the schedule if the available account limit is less than this configured value",
          "examples": [
            25.75,
            125.0,
            57.25
          ]
        }
      }
    },
    "retries": {
      "type": "object",
      "title": "Retries object",
      "description": "Object with information about schedule retries",
      "required": [
        "number_of_attempts",
        "interval_recurrence"
      ],
      "properties": {
        "number_of_attempts": {
          "type": "integer",
          "title": "Number of attempts",
          "description": "Number of times to attempt executing this scheduled payment if it doesn't execute successfully",
          "examples": [
            1,
            2,
            3
          ]
        },
        "interval_recurrence": {
          "type": "integer",
          "title": "Interval recurrence",
          "description": "Minutes to delay before making the next attempt",
          "examples": [
            1,
            2,
            3
          ]
        }
      }
    },
    "schedule_details": {
      "type": "object",
      "title": "Details object",
      "description": "Object with schedule details",
      "if": {
        "properties": {
          "type": {
            "const": "RECURRING"
          }
        }
      },
      "then": {
        "required": [
          "interval",
          "end_date"
        ]
      },
      "properties": {
        "type": {
          "type": "string",
          "title": "Type",
          "description": "Schedule type",
          "enum": [
            "ONCE",
            "RECURRING"
          ],
          "examples": [
            "RECURRING"
          ]
        },
        "interval": {
          "type": "string",
          "title": "Interval",
          "description": "Schedule interval",
          "enum": [
            "DAILY",
            "WEEKLY",
            "MONTHLY",
            "YEARLY"
          ],
          "examples": [
            "DAILY"
          ]
        },
        "start_date": {
          "$ref": "#/definitions/start_date"
        },
        "end_date": {
          "type": "string",
          "format": "date-time",
          "title": "End date",
          "description": "End date of the schedule in UTC-0 (RFC3339) format: yyyy-MM-ddThh:mm:ss.SSSZ",
          "examples": [
            "2024-01-01T00:00:00.000Z"
          ]
        },
        "day_type": {
          "type": "string",
          "title": "Day type",
          "description": "Schedule day type",
          "enum": [
            "CALENDAR_DAY",
            "BUSINESS_DAY"
          ],
          "examples": [
            "BUSINESS_DAY"
          ]
        },
        "retries": {
          "$ref": "#/definitions/retries"
        }
      }
    },
    "scraping_details": {
      "type": "object",
      "title": "Scraping details object",
      "description": "Object with scraping details",
      "required": [
        "available_date"
      ],
      "properties": {
        "available_date": {
          "type": "string",
          "format": "date-time",
          "title": "Available date",
          "description": "Date and time of the cut-off moment for account scraping in UTC-0 (RFC3339) format: yyyy-MM-ddThh:mm:ss.SSSZ",
          "examples": [
            "2024-01-01T00:00:00.000Z"
          ]
        }
      }
    },
    "scraping_schedule_details": {
      "type": "object",
      "title": "Details object",
      "description": "Object with schedule details",
      "required": [
        "start_date"
      ],
      "properties": {
        "start_date": {
          "$ref": "#/definitions/start_date"
        }
      }
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "title": "Start date",
      "description": "Start date of the schedule in UTC-0 (RFC3339) format: yyyy-MM-ddThh:mm:ss.SSSZ",
      "examples": [
        "2024-01-01T00:00:00.000Z"
      ]
    },
    "pre_schedule_details": {
      "type": "object",
      "title": "Details object",
      "description": "Object with schedule details",
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "$ref": "#/definitions/statement"
        }
      }
    },
    "processing_code": {
      "type": "string",
      "title": "Processing code",
      "description": "Processing code used for authorization",
      "examples": [
        "007700",
        "009900",
        "007200"
      ]
    },
    "processing_codes": {
      "type": "object",
      "title": "Processing codes",
      "description": "Object with both processing codes operations, credit and debit",
      "required": [
        "credit",
        "debit"
      ],
      "properties": {
        "credit": {
          "$ref": "#/definitions/processing_code"
        },
        "debit": {
          "$ref": "#/definitions/processing_code"
        }
      }
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "description": "Authorization amount",
      "minimum": 1,
      "examples": [
        20.1,
        100.0,
        50
      ]
    },
    "currency": {
      "type": "string",
      "title": "Currency code",
      "description": "Three-letter currency code (ISO 4217)",
      "examples": [
        "CLP",
        "USD",
        "BRL"
      ]
    },
    "transfers": {
      "type": "array",
      "title": "List of transfers",
      "items": {
        "$ref": "#/definitions/transfer"
      }
    },
    "transfer": {
      "type": "object",
      "title": "Transfer",
      "description": "Information about the transfer",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "amount": {
          "type": "number",
          "title": "Amount",
          "description": "Transfer amount",
          "minimum": 1,
          "examples": [
            20.1,
            100.0,
            50
          ]
        },
        "description": {
          "type": "string",
          "title": "Transfer description",
          "description": "Transfer description",
          "examples": [
            "First transfer",
            "Second transfer"
          ]
        },
        "metadata": {
          "type": "object",
          "title": "Metadata",
          "description": "Additional information relevant to the customer. No business rule validation is performed on it.",
          "examples": [
            {
              "metadata": {
                "customer-data": {
                  "any": "fields"
                }
              }
            }
          ]
        },
        "from": {
          "type": "object",
          "title": "From",
          "description": "Information about the origin account",
          "required": [
            "account_id",
            "processing_code"
          ],
          "properties": {
            "account_id": {
              "$ref": "#/definitions/account_id"
            },
            "processing_code": {
              "$ref": "#/definitions/processing_code"
            }
          }
        },
        "to": {
          "type": "object",
          "title": "To",
          "description": "Information about the destination account",
          "required": [
            "account_id",
            "processing_code"
          ],
          "properties": {
            "account_id": {
              "$ref": "#/definitions/account_id"
            },
            "processing_code": {
              "$ref": "#/definitions/processing_code"
            }
          }
        }
      }
    },
    "strategy": {
      "type": "string",
      "title": "Strategy",
      "description": "Schedule strategy: SWEEP (transfers the entire balance from the child account to the parent account, the terms 'parent' and 'child' refer to account roles, but no relationship validation is performed) or OVERDRAFT_SWEEP (follows the same logic as `SWEEP`, except when a child account is negative, in which case the main account sends enough money for the child account to stop being negative)",
      "enum": [
        "SWEEP",
        "OVERDRAFT_SWEEP"
      ],
      "examples": [
        "SWEEP"
      ]
    },
    "statement": {
      "type": "object",
      "title": "Details object",
      "description": "Object with statement",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "title": "Statement ID",
          "description": "Statement ID",
          "examples": [
            100602614
          ]
        }
      }
    }
  }
}